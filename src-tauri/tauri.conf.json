{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelpDesk Manager",
  "version": "0.3.0",
  "identifier": "com.rdpmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HelpDesk Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "decorations": true,
        "visible": false,
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HelpDesk Manager",
    "shortDescription": "Gestione help desk, clienti e connessioni remote",
    "longDescription": "HelpDesk Manager: clienti, rubrica, pianificazione, connessioni RDP/VPN e credenziali protette con vault locale.",
    "category": "Business",
    "copyright": "Copyright © 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
